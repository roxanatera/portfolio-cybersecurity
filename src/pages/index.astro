---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Julia Roxana Natera | Web Developer">
  <!-- NAV -->
  <nav
    class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-8 py-4 md:py-5 bg-[#07070f]/80 backdrop-blur-md border-b border-cyan-500/10"
  >
    <a href="#" class="font-bold text-xl tracking-tight text-white"
      >JRN<span class="text-cyan-400">.</span>
    </a>
    <ul class="hidden md:flex gap-8 list-none">
      <li>
        <a
          href="#about"
          class="text-gray-500 hover:text-cyan-400 transition-colors text-sm tracking-wide"
          data-es="Sobre mí"
          data-en="About">Sobre mí</a
        >
      </li>
      <li>
        <a
          href="#skills"
          class="text-gray-500 hover:text-cyan-400 transition-colors text-sm tracking-wide"
          data-es="Skills"
          data-en="Skills">Skills</a
        >
      </li>
      <li>
        <a
          href="#projects"
          class="text-gray-500 hover:text-cyan-400 transition-colors text-sm tracking-wide"
          data-es="Proyectos"
          data-en="Projects">Proyectos</a
        >
      </li>
      <li>
        <a
          href="#contact"
          class="text-gray-500 hover:text-cyan-400 transition-colors text-sm tracking-wide"
          data-es="Contacto"
          data-en="Contact">Contacto</a
        >
      </li>
    </ul>
    <div class="flex items-center gap-3">
      <button
        id="langToggle"
        class="border border-cyan-500/20 text-cyan-400 px-3 md:px-4 py-1.5 rounded text-xs font-bold tracking-wider hover:bg-cyan-400/10 transition-colors cursor-pointer bg-transparent"
        >EN</button
      >
      <!-- Mobile menu button -->
      <button
        id="menuToggle"
        class="md:hidden text-gray-400 hover:text-cyan-400 transition-colors"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- MOBILE MENU -->
  <div
    id="mobileMenu"
    class="fixed top-[65px] left-0 right-0 z-40 bg-[#07070f]/95 backdrop-blur-md border-b border-cyan-500/10 hidden flex-col px-6 py-4 gap-4"
  >
    <a
      href="#about"
      class="text-gray-400 hover:text-cyan-400 transition-colors text-sm py-2 border-b border-cyan-500/10"
      data-es="Sobre mí"
      data-en="About">Sobre mí</a
    >
    <a
      href="#skills"
      class="text-gray-400 hover:text-cyan-400 transition-colors text-sm py-2 border-b border-cyan-500/10"
      data-es="Skills"
      data-en="Skills">Skills</a
    >
    <a
      href="#projects"
      class="text-gray-400 hover:text-cyan-400 transition-colors text-sm py-2 border-b border-cyan-500/10"
      data-es="Proyectos"
      data-en="Projects">Proyectos</a
    >
    <a
      href="#contact"
      class="text-gray-400 hover:text-cyan-400 transition-colors text-sm py-2"
      data-es="Contacto"
      data-en="Contact">Contacto</a
    >
  </div>

  <!-- HERO -->
  <section
    id="hero"
    class="min-h-screen flex items-center justify-center px-6 md:px-8 pt-28 md:pt-32 pb-16 relative text-center"
  >
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] md:w-[600px] h-[300px] md:h-[600px] rounded-full bg-[radial-gradient(circle,rgba(0,212,255,0.06),transparent)] pointer-events-none"
    >
    </div>
    <div class="max-w-4xl w-full relative z-10">
      <p
        class="fade-up-1 text-xs tracking-[0.2em] uppercase text-cyan-400 mb-3 block"
        data-es="Bienvenida a mi portfolio"
        data-en="Welcome to my portfolio"
      >
        Bienvenida a mi portfolio
      </p>
      <h1
        class="fade-up-2 text-5xl sm:text-6xl md:text-8xl font-black tracking-tight leading-none mb-4"
      >
        Julia Roxana<br />
        <span class="text-cyan-400 glow-text">Natera</span>
      </h1>
      <p
        class="fade-up-3 text-base sm:text-lg md:text-2xl text-gray-500 mb-3"
        data-es="Desarrolladora Web"
        data-en="Web Developer"
      >
        Desarrolladora Web
      </p>
      <p
        class="fade-up-4 text-xs sm:text-sm text-gray-500 max-w-xl mx-auto mb-10 leading-relaxed"
        data-es="Construyendo la web del futuro · Aprendiendo Linux y Ciberseguridad paso a paso"
        data-en="Building the future web · Learning Linux and Cybersecurity step by step"
      >
        Construyendo la web del futuro · Aprendiendo Linux y Ciberseguridad paso
        a paso
      </p>
      <div
        class="fade-up-5 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center"
      >
        <a
          href="#projects"
          class="w-full sm:w-auto bg-cyan-400 text-[#07070f] px-8 py-3 rounded font-bold text-sm tracking-wider hover:bg-white hover:shadow-[0_0_30px_rgba(0,212,255,0.4)] hover:-translate-y-0.5 transition-all text-center"
          data-es="Ver Proyectos →"
          data-en="View Projects →">Ver Proyectos →</a
        >
        <a
          href="#contact"
          class="w-full sm:w-auto border border-cyan-400 text-cyan-400 px-8 py-3 rounded font-bold text-sm tracking-wider hover:bg-cyan-400/10 hover:-translate-y-0.5 transition-all text-center"
          data-es="Contactar"
          data-en="Contact">Contactar</a
        >
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-16 md:py-24 px-6 md:px-8 max-w-6xl mx-auto">
    <div
      class="flex flex-col md:grid md:grid-cols-[1fr_1.8fr] gap-10 md:gap-20 items-center"
    >
      <!-- Avatar -->
      <div class="flex flex-col items-center gap-5">
        <div
          class="relative w-32 h-32 md:w-44 md:h-44 rounded-full border-2 border-cyan-400/40 overflow-hidden ring-4 ring-cyan-400/10"
        >
          <img
            src="/me.png"
            alt="Julia Roxana Natera"
            class="w-full h-full object-cover"
            style="object-position: center 20%;"
          />
        </div>
        <div class="text-center">
          <p class="font-bold text-base md:text-lg">Julia Roxana Natera</p>
          <p
            class="text-cyan-400 text-xs tracking-widest mt-1"
            data-es="Desarrolladora Web"
            data-en="Web Developer"
          >
            Desarrolladora Web
          </p>
        </div>
        <div
          class="flex items-center gap-2 border border-cyan-400/20 bg-cyan-400/5 rounded-full px-4 py-2"
        >
          <span class="status-dot w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span
            class="text-cyan-400 text-xs"
            data-es="Disponible para trabajar"
            data-en="Available for work">Disponible para trabajar</span
          >
        </div>
      </div>
      <!-- Bio -->
      <div class="text-center md:text-left">
        <p class="text-xs tracking-[0.2em] uppercase text-cyan-400 mb-3 block">
          Sobre mí
        </p>
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-6"
        >
          <span data-es="Construyo interfaces." data-en="I build interfaces."
            >Construyo interfaces.</span
          ><br />
          <span
            class="text-cyan-400"
            data-es="Aprendo a protegerlas."
            data-en="I learn to protect them.">Aprendo a protegerlas.</span
          >
        </h2>
        <p
          class="text-gray-500 mb-4 text-sm leading-relaxed"
          data-es="Soy desarrolladora web junior con pasión por crear experiencias digitales limpias, rápidas y accesibles. Me especializo en tecnologías modernas como Astro y Tailwind CSS, construyendo interfaces que combinan estética y rendimiento."
          data-en="I'm a junior web developer passionate about creating clean, fast, and accessible digital experiences. I specialize in modern technologies like Astro and Tailwind CSS, building interfaces that combine aesthetics and performance."
        >
          Soy desarrolladora web junior con pasión por crear experiencias
          digitales limpias, rápidas y accesibles. Me especializo en tecnologías
          modernas como Astro y Tailwind CSS, construyendo interfaces que
          combinan estética y rendimiento.
        </p>
        <p
          class="text-gray-500 mb-8 text-sm leading-relaxed"
          data-es="Actualmente me estoy formando en ciberseguridad y Linux, con la visión de convertirme en una desarrolladora que no solo construye la web, sino que también la protege desde el primer commit."
          data-en="I'm currently training in cybersecurity and Linux, with the vision of becoming a developer who not only builds the web but also protects it from the first commit."
        >
          Actualmente me estoy formando en ciberseguridad y Linux, con la visión
          de convertirme en una desarrolladora que no solo construye la web,
          sino que también la protege desde el primer commit.
        </p>
        <div class="flex gap-3 flex-wrap justify-center md:justify-start">
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs font-medium"
            >Sevilla, España</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs font-medium"
            >Open to work</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs font-medium"
            >Junior Dev</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="py-16 md:py-24 px-6 md:px-8 bg-[#0d0d1a]">
    <div class="max-w-6xl mx-auto">
      <p
        class="text-xs tracking-[0.2em] uppercase text-cyan-400 mb-3 block text-center"
        data-es="Lo que sé hacer"
        data-en="What I can do"
      >
        Lo que sé hacer
      </p>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-center mb-10 md:mb-14"
        data-es="Skills & Tecnologías"
        data-en="Skills & Technologies"
      >
        Skills & Tecnologías
      </h2>
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6"
      >
        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🌐</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">
            HTML & CSS
          </h3>
          <p
            class="text-gray-500 text-xs"
            data-es="Semántico, accesible y moderno"
            data-en="Semantic, accessible and modern"
          >
            Semántico, accesible y moderno
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">⚡</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">
            JavaScript
          </h3>
          <p
            class="text-gray-500 text-xs"
            data-es="ES6+, DOM, eventos"
            data-en="ES6+, DOM, events"
          >
            ES6+, DOM, eventos
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🚀</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">Astro</h3>
          <p
            class="text-gray-500 text-xs"
            data-es="Sitios estáticos ultrarrápidos"
            data-en="Ultra-fast static sites"
          >
            Sitios estáticos ultrarrápidos
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🎨</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">
            Tailwind CSS
          </h3>
          <p
            class="text-gray-500 text-xs"
            data-es="Utility-first, diseño rápido"
            data-en="Utility-first, rapid design"
          >
            Utility-first, diseño rápido
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🐙</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">
            Git & GitHub
          </h3>
          <p
            class="text-gray-500 text-xs"
            data-es="Control de versiones"
            data-en="Version control"
          >
            Control de versiones
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🐧</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">Linux</h3>
          <p
            class="text-cyan-400/70 text-xs"
            data-es="Aprendiendo · Ubuntu"
            data-en="Learning · Ubuntu"
          >
            Aprendiendo · Ubuntu
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🔐</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">
            Ciberseguridad
          </h3>
          <p
            class="text-cyan-400/70 text-xs"
            data-es="Formándome · En progreso"
            data-en="Training · In progress"
          >
            Formándome · En progreso
          </p>
        </div>

        <div
          class="bg-white/3 border border-cyan-500/10 rounded-xl p-5 md:p-7 text-center hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
        >
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">📱</div>
          <h3 class="font-bold text-sm md:text-base mb-1 md:mb-2">
            Responsive Design
          </h3>
          <p
            class="text-gray-500 text-xs"
            data-es="Mobile-first siempre"
            data-en="Mobile-first always"
          >
            Mobile-first siempre
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="py-16 md:py-24 px-6 md:px-8 max-w-6xl mx-auto">
    <p
      class="text-xs tracking-[0.2em] uppercase text-cyan-400 mb-3 block text-center"
      data-es="Lo que he construido"
      data-en="What I've built"
    >
      Lo que he construido
    </p>
    <h2
      class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-center mb-10 md:mb-14"
      data-es="Proyectos"
      data-en="Projects"
    >
      Proyectos
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
      <div
        class="bg-white/3 border border-cyan-500/10 rounded-xl p-6 md:p-8 hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
      >
        <div class="flex justify-between items-start mb-5">
          <span class="text-3xl md:text-4xl">🌐</span>
          <a
            href="https://github.com/roxanatera/portfolio-cybersecurity"
            target="_blank"
            class="text-gray-500 hover:text-cyan-400 text-xs transition-colors"
            >GitHub →</a
          >
        </div>
        <h3
          class="font-bold text-base md:text-lg mb-3"
          data-es="Portfolio Personal"
          data-en="Personal Portfolio"
        >
          Portfolio Personal
        </h3>
        <p
          class="text-gray-500 text-xs md:text-sm mb-6 leading-relaxed"
          data-es="Este mismo portfolio. Construido con Astro y Tailwind CSS con diseño dark mode elegante y soporte bilingüe."
          data-en="This very portfolio. Built with Astro and Tailwind CSS with elegant dark mode design and bilingual support."
        >
          Este mismo portfolio. Construido con Astro y Tailwind CSS con diseño
          dark mode elegante y soporte bilingüe.
        </p>
        <div class="flex gap-2 flex-wrap">
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            >Astro</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            >Tailwind</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            >CSS</span
          >
        </div>
      </div>

      <div
        class="bg-white/3 border border-cyan-500/10 rounded-xl p-6 md:p-8 hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all"
      >
        <div class="flex justify-between items-start mb-5">
          <span class="text-3xl md:text-4xl">🐧</span>
          <a
            href="https://github.com/roxanatera/linux-security-toolkit"
            target="_blank"
            class="text-gray-500 hover:text-cyan-400 text-xs transition-colors"
            >GitHub →</a
          >
        </div>
        <h3
          class="font-bold text-base md:text-lg mb-3"
          data-es="Linux Security Toolkit"
          data-en="Linux Security Toolkit"
        >
          Linux Security Toolkit
        </h3>
        <p
          class="text-gray-500 text-xs md:text-sm mb-6 leading-relaxed"
          data-es="Scripts Bash para auditoría y seguridad en Linux. Documentación de aprendizaje por módulo."
          data-en="Bash scripts for Linux auditing and security. Learning documentation by module."
        >
          Scripts Bash para auditoría y seguridad en Linux. Documentación de
          aprendizaje por módulo.
        </p>
        <div class="flex gap-2 flex-wrap">
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            >Linux</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            >Bash</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            data-es="En progreso"
            data-en="In progress">En progreso</span
          >
        </div>
      </div>

      <div
        class="bg-white/3 border border-cyan-500/10 rounded-xl p-6 md:p-8 hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all sm:col-span-2 md:col-span-1"
      >
        <div class="flex justify-between items-start mb-5">
          <span class="text-3xl md:text-4xl">⚡</span>
          <a
            href="https://github.com/roxanatera"
            target="_blank"
            class="text-gray-500 hover:text-cyan-400 text-xs transition-colors"
            >GitHub →</a
          >
        </div>
        <h3
          class="font-bold text-base md:text-lg mb-3"
          data-es="Próximo proyecto"
          data-en="Next project"
        >
          Próximo proyecto
        </h3>
        <p
          class="text-gray-500 text-xs md:text-sm mb-6 leading-relaxed"
          data-es="Próximamente. Nuevos proyectos en construcción combinando desarrollo web y seguridad."
          data-en="Coming soon. New projects in construction combining web development and security."
        >
          Próximamente. Nuevos proyectos en construcción combinando desarrollo
          web y seguridad.
        </p>
        <div class="flex gap-2 flex-wrap">
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            >JavaScript</span
          >
          <span
            class="bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs"
            data-es="Próximamente"
            data-en="Coming soon">Próximamente</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-16 md:py-24 px-6 md:px-8 bg-[#0d0d1a]">
    <div class="max-w-2xl mx-auto text-center">
      <p
        class="text-xs tracking-[0.2em] uppercase text-cyan-400 mb-3 block"
        data-es="Hablemos"
        data-en="Let's talk"
      >
        Hablemos
      </p>
      <h2
        class="text-3xl sm:text-4xl md:text-6xl font-black tracking-tight mb-4"
        data-es="¿Tienes un proyecto?"
        data-en="Got a project?"
      >
        ¿Tienes un proyecto?
      </h2>
      <p
        class="text-gray-500 mb-10 md:mb-12 text-sm leading-relaxed"
        data-es="Estoy buscando mi primera oportunidad profesional. Si tienes un proyecto interesante o una posición junior, me encantaría escucharte."
        data-en="I'm looking for my first professional opportunity. If you have an interesting project or a junior position, I'd love to hear from you."
      >
        Estoy buscando mi primera oportunidad profesional. Si tienes un proyecto
        interesante o una posición junior, me encantaría escucharte.
