---
// src/pages/certifications.astro
// Página de Certificaciones y Logros
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Certificaciones | Portfolio</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Outfit:wght@300;400;600;700&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                --bg: #080c10;
                --surface: #0d1117;
                --border: #1e2d3d;
                --cyan: #00e5ff;
                --cyan-dim: #00e5ff33;
                --green: #39d353;
                --orange: #f0883e;
                --text: #cdd9e5;
                --text-muted: #6e7f8d;
                --mono: "Share Tech Mono", monospace;
                --sans: "Outfit", sans-serif;
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: var(--sans);
                min-height: 100vh;
                overflow-x: hidden;
            }

            /* Grid background */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background-image: linear-gradient(
                        var(--border) 1px,
                        transparent 1px
                    ),
                    linear-gradient(90deg, var(--border) 1px, transparent 1px);
                background-size: 40px 40px;
                opacity: 0.35;
                pointer-events: none;
                z-index: 0;
            }

            /* ── NAV ── */
            nav {
                position: sticky;
                top: 0;
                z-index: 100;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1rem 2rem;
                background: rgba(8, 12, 16, 0.85);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border);
            }

            .nav-logo {
                font-family: var(--mono);
                font-size: 1rem;
                color: var(--cyan);
                text-decoration: none;
                letter-spacing: 0.05em;
            }

            .nav-links {
                display: flex;
                gap: 2rem;
                list-style: none;
            }

            .nav-links a {
                font-size: 0.85rem;
                color: var(--text-muted);
                text-decoration: none;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                transition: color 0.2s;
            }

            .nav-links a:hover,
            .nav-links a.active {
                color: var(--cyan);
            }

            /* ── MAIN ── */
            main {
                position: relative;
                z-index: 1;
                max-width: 1100px;
                margin: 0 auto;
                padding: 4rem 2rem 6rem;
            }

            /* ── HEADER ── */
            .page-header {
                margin-bottom: 4rem;
                animation: fadeDown 0.6s ease both;
            }

            .page-header .label {
                font-family: var(--mono);
                font-size: 0.75rem;
                color: var(--cyan);
                letter-spacing: 0.2em;
                text-transform: uppercase;
                margin-bottom: 0.75rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .page-header .label::before {
                content: "";
                display: inline-block;
                width: 1.5rem;
                height: 1px;
                background: var(--cyan);
            }

            .page-header h1 {
                font-size: clamp(2rem, 5vw, 3.5rem);
                font-weight: 700;
                line-height: 1.1;
                color: #fff;
            }

            .page-header h1 span {
                color: var(--cyan);
            }

            .page-header p {
                margin-top: 1rem;
                color: var(--text-muted);
                max-width: 520px;
                line-height: 1.7;
                font-size: 0.95rem;
            }

            /* ── STATS BAR ── */
            .stats-bar {
                display: flex;
                gap: 2rem;
                flex-wrap: wrap;
                margin-bottom: 3.5rem;
                padding: 1.5rem 2rem;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 8px;
                animation: fadeUp 0.6s 0.1s ease both;
            }

            .stat {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
            }

            .stat-value {
                font-family: var(--mono);
                font-size: 1.75rem;
                font-weight: 700;
                color: var(--cyan);
            }

            .stat-label {
                font-size: 0.75rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .stat-divider {
                width: 1px;
                background: var(--border);
                align-self: stretch;
            }

            /* ── SECTION TITLE ── */
            .section-title {
                font-family: var(--mono);
                font-size: 0.7rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.2em;
                margin-bottom: 1.25rem;
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .section-title::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--border);
            }

            /* ── CERT GRID ── */
            .cert-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
                gap: 1.25rem;
                margin-bottom: 3rem;
            }

            /* ── CERT CARD ── */
            .cert-card {
                position: relative;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 1rem;
                transition: border-color 0.25s, transform 0.25s;
                overflow: hidden;
                animation: fadeUp 0.5s ease both;
            }

            .cert-card:hover {
                border-color: var(--cyan);
                transform: translateY(-3px);
            }

            .cert-card::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(
                    ellipse at top left,
                    var(--cyan-dim),
                    transparent 70%
                );
                opacity: 0;
                transition: opacity 0.3s;
            }

            .cert-card:hover::before {
                opacity: 1;
            }

            /* Status badge */
            .cert-status {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                font-family: var(--mono);
                font-size: 0.65rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                padding: 0.25rem 0.6rem;
                border-radius: 3px;
                align-self: flex-start;
            }

            .cert-status.completed {
                background: rgba(57, 211, 83, 0.12);
                color: var(--green);
                border: 1px solid rgba(57, 211, 83, 0.3);
            }

            .cert-status.in-progress {
                background: rgba(240, 136, 62, 0.12);
                color: var(--orange);
                border: 1px solid rgba(240, 136, 62, 0.3);
            }

            .cert-status.planned {
                background: rgba(110, 127, 141, 0.12);
                color: var(--text-muted);
                border: 1px solid var(--border);
            }

            .cert-status::before {
                content: "";
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: currentColor;
            }

            .cert-status.in-progress::before {
                animation: pulse 1.5s infinite;
            }

            /* Card header */
            .cert-issuer {
                font-family: var(--mono);
                font-size: 0.7rem;
                color: var(--text-muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

            .cert-name {
                font-size: 1.05rem;
                font-weight: 600;
                color: #fff;
                line-height: 1.3;
            }

            /* Progress bar (for in-progress) */
            .cert-progress {
                display: flex;
                flex-direction: column;
                gap: 0.4rem;
            }

            .progress-label {
                display: flex;
                justify-content: space-between;
                font-family: var(--mono);
                font-size: 0.65rem;
                color: var(--text-muted);
            }

            .progress-bar {
                height: 3px;
                background: var(--border);
                border-radius: 2px;
                overflow: hidden;
            }

            .progress-fill {
                height: 100%;
                background: linear-gradient(90deg, var(--orange), #ffb347);
                border-radius: 2px;
                transition: width 1s ease;
            }

            /* Card footer */
            .cert-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-top: auto;
                padding-top: 0.75rem;
                border-top: 1px solid var(--border);
            }

            .cert-date {
                font-family: var(--mono);
                font-size: 0.7rem;
                color: var(--text-muted);
            }

            .cert-link {
                font-family: var(--mono);
                font-size: 0.7rem;
                color: var(--cyan);
                text-decoration: none;
                opacity: 0.6;
                transition: opacity 0.2s;
            }

            .cert-link:hover {
                opacity: 1;
            }

            /* Placeholder card */
            .cert-card.placeholder {
                border-style: dashed;
                opacity: 0.45;
                cursor: default;
            }

            .cert-card.placeholder:hover {
                transform: none;
                border-color: var(--border);
            }

            .cert-card.placeholder::before {
                display: none;
            }

            .placeholder-icon {
                font-size: 1.5rem;
                filter: grayscale(1);
            }

            /* ── TIMELINE (logros) ── */
            .timeline {
                display: flex;
                flex-direction: column;
                gap: 0;
                margin-bottom: 3rem;
            }

            .timeline-item {
                display: grid;
                grid-template-columns: 120px 1px 1fr;
                gap: 0 1.5rem;
                animation: fadeUp 0.5s ease both;
            }

            .timeline-date {
                font-family: var(--mono);
                font-size: 0.7rem;
                color: var(--text-muted);
                text-align: right;
                padding: 1.5rem 0;
                line-height: 1.4;
            }

            .timeline-line {
                position: relative;
                background: var(--border);
            }

            .timeline-dot {
                position: absolute;
                top: 1.65rem;
                left: 50%;
                transform: translateX(-50%);
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--cyan);
                border: 2px solid var(--bg);
            }

            .timeline-dot.dim {
                background: var(--border);
            }

            .timeline-content {
                padding: 1.25rem 0 1.25rem 0.5rem;
            }

            .timeline-content h3 {
                font-size: 0.95rem;
                font-weight: 600;
                color: #fff;
                margin-bottom: 0.25rem;
            }

            .timeline-content p {
                font-size: 0.8rem;
                color: var(--text-muted);
                line-height: 1.5;
            }

            /* ── EMPTY STATE ── */
            .empty-note {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 1rem 1.5rem;
                background: rgba(0, 229, 255, 0.04);
                border: 1px dashed rgba(0, 229, 255, 0.2);
                border-radius: 6px;
                margin-bottom: 3rem;
            }

            .empty-note span {
                font-family: var(--mono);
                font-size: 0.75rem;
                color: var(--text-muted);
            }

            .empty-note strong {
                color: var(--cyan);
            }

            /* ── ANIMATIONS ── */
            @keyframes fadeDown {
                from {
                    opacity: 0;
                    transform: translateY(-16px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes pulse {
                0%,
                100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0.3;
                }
            }

            /* Stagger children */
            .cert-card:nth-child(1) {
                animation-delay: 0.05s;
            }
            .cert-card:nth-child(2) {
                animation-delay: 0.1s;
            }
            .cert-card:nth-child(3) {
                animation-delay: 0.15s;
            }
            .cert-card:nth-child(4) {
                animation-delay: 0.2s;
            }
            .cert-card:nth-child(5) {
                animation-delay: 0.25s;
            }
            .cert-card:nth-child(6) {
                animation-delay: 0.3s;
            }

            .timeline-item:nth-child(1) {
                animation-delay: 0.05s;
            }
            .timeline-item:nth-child(2) {
                animation-delay: 0.12s;
            }
            .timeline-item:nth-child(3) {
                animation-delay: 0.19s;
            }

            /* ── RESPONSIVE ── */
            @media (max-width: 600px) {
                nav {
                    padding: 1rem;
                }
                .nav-links {
                    gap: 1.25rem;
                }
                .stats-bar {
                    gap: 1.25rem;
                }
                .stat-divider {
                    display: none;
                }
                .timeline-item {
                    grid-template-columns: 70px 1px 1fr;
                    gap: 0 1rem;
                }
                .timeline-date {
                    font-size: 0.6rem;
                }
            }
        </style>
    </head>
    <body>
        <!-- NAV -->
        <nav>
            <a href="/" class="nav-logo">~/roxana</a>
            <ul class="nav-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/projects">Proyectos</a></li>
                <li><a href="/certifications" class="active">Certs</a></li>
                <li><a href="/#contact">Contacto</a></li>
            </ul>
        </nav>

        <main>
            <!-- HEADER -->
            <header class="page-header">
                <p class="label">Trayectoria</p>
                <h1>Certificaciones<br /><span>&amp; Logros</span></h1>
                <p>
                    Formación continua en ciberseguridad, desarrollo web y
                    sistemas Linux. Cada certificación es un paso más hacia
                    dominar el stack completo.
                </p>
            </header>

            <!-- STATS -->
            <div class="stats-bar">
                <div class="stat">
                    <span class="stat-value" id="count-completed">0</span>
                    <span class="stat-label">Completadas</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat">
                    <span class="stat-value" id="count-progress">0</span>
                    <span class="stat-label">En progreso</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat">
                    <span class="stat-value" id="count-planned">0</span>
                    <span class="stat-label">Planificadas</span>
                </div>
            </div>

            <!-- NOTA placeholder -->
            <div class="empty-note">
                <span>🔒</span>
                <span
                    ><strong>// TODO:</strong> Reemplaza las tarjetas de ejemplo
                    con tus certificaciones reales. Cada card acepta: nombre, entidad
                    emisora, fecha, estado y enlace de verificación.</span
                >
            </div>

            <!-- CERTIFICACIONES -->
            <p class="section-title">Certificaciones</p>

            <div class="cert-grid">
                <!-- PLACEHOLDER 1 — completada -->
                <div class="cert-card" data-status="completed">
                    <span class="cert-status completed">Completada</span>
                    <div>
                        <p class="cert-issuer">Entidad emisora</p>
                        <p class="cert-name">Nombre de la certificación</p>
                    </div>
                    <div class="cert-footer">
                        <span class="cert-date">mes / año</span>
                        <a href="#" class="cert-link">ver credencial →</a>
                    </div>
                </div>

                <!-- PLACEHOLDER 2 — en progreso -->
                <div class="cert-card" data-status="in-progress">
                    <span class="cert-status in-progress">En progreso</span>
                    <div>
                        <p class="cert-issuer">Entidad emisora</p>
                        <p class="cert-name">Nombre de la certificación</p>
                    </div>
                    <div class="cert-progress">
                        <div class="progress-label">
                            <span>Progreso</span>
                            <span>40%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 40%"></div>
                        </div>
                    </div>
                    <div class="cert-footer">
                        <span class="cert-date">en curso</span>
                    </div>
                </div>

                <!-- PLACEHOLDER 3 — planificada -->
                <div class="cert-card placeholder" data-status="planned">
                    <span class="cert-status planned">Planificada</span>
                    <div>
                        <p class="cert-issuer" style="opacity:.5">
                            Próximamente
                        </p>
                        <p class="cert-name" style="opacity:.5">
                            Certificación objetivo
                        </p>
                    </div>
                    <div class="cert-footer">
                        <span class="cert-date">— / —</span>
                    </div>
                </div>

                <!-- PLACEHOLDER 4 -->
                <div class="cert-card placeholder" data-status="planned">
                    <span class="cert-status planned">Planificada</span>
                    <div>
                        <p class="cert-issuer" style="opacity:.5">
                            Próximamente
                        </p>
                        <p class="cert-name" style="opacity:.5">
                            Certificación objetivo
                        </p>
                    </div>
                    <div class="cert-footer">
                        <span class="cert-date">— / —</span>
                    </div>
                </div>
            </div>

            <!-- LOGROS / TIMELINE -->
            <p class="section-title">Logros &amp; Hitos</p>

            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-date">próximamente</div>
                    <div class="timeline-line">
                        <div class="timeline-dot dim"></div>
                    </div>
                    <div class="timeline-content">
                        <h3>Logro objetivo</h3>
                        <p>
                            Descripción breve del hito — primer CTF completado,
                            primer bug bounty, primer proyecto en producción...
                        </p>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-date">próximamente</div>
                    <div class="timeline-line">
                        <div class="timeline-dot dim"></div>
                    </div>
                    <div class="timeline-content">
                        <h3>Logro objetivo</h3>
                        <p>Descripción breve del hito.</p>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-date">2024</div>
                    <div class="timeline-line">
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-content">
                        <h3>
                            DAW — Técnica Superior en Desarrollo de Aplicaciones
                            Web
                        </h3>
                        <p>
                            ILERNA · Formación oficial completada. Base sólida
                            en frontend, backend y bases de datos.
                        </p>
                    </div>
                </div>
            </div>
        </main>

        <script>
            function updateStats() {
                const completed = document.querySelectorAll(
                    '.cert-card:not(.placeholder)[data-status="completed"]'
                ).length;
                const inProgress = document.querySelectorAll(
                    '.cert-card:not(.placeholder)[data-status="in-progress"]'
                ).length;
                const planned = document.querySelectorAll(
                    '.cert-card[data-status="planned"]'
                ).length;

                const elCompleted = document.getElementById("count-completed");
                const elProgress = document.getElementById("count-progress");
                const elPlanned = document.getElementById("count-planned");

                if (elCompleted) elCompleted.textContent = String(completed);
                if (elProgress) elProgress.textContent = String(inProgress);
                if (elPlanned) elPlanned.textContent = String(planned);
            }

            updateStats();
        </script>
    </body>
</html>
